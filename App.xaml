<Application x:Class="Altechap.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Ressources globales : palette + templates communs -->
                <ResourceDictionary>
                    <!-- Template bouton arrondi — disponible dans TOUS les contextes -->
                    <ControlTemplate x:Key="RB" TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="30" MinWidth="30"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.50"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>

                    <!-- Bouton « effacer » discret : neutre au repos, rouge au survol.
                         Un aplat rouge permanent attire l'œil sur une action secondaire. -->
                    <ControlTemplate x:Key="RBClear" TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="#E8DDD0" BorderBrush="#C9BCA6" BorderThickness="1.5"
                                TextElement.Foreground="#B5776A"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="#D94F3D"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#B8402F"/>
                                <Setter TargetName="bd" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="#B8402F"/>
                                <Setter TargetName="bd" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>

                    <!-- Styles globaux boutons -->
                    <Style x:Key="Btn" TargetType="Button">
                        <Setter Property="Template"        Value="{StaticResource RB}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor"          Value="Hand"/>
                        <Setter Property="Padding"         Value="12,0"/>
                        <Setter Property="Height"          Value="32"/>
                        <Setter Property="FontSize"        Value="12"/>
                        <Setter Property="FontFamily"      Value="Segoe UI"/>
                        <Setter Property="Foreground"      Value="#2D1A00"/>
                    </Style>
                    <Style x:Key="BtnPrimary" BasedOn="{StaticResource Btn}" TargetType="Button">
                        <Setter Property="Background" Value="#F5B942"/>
                        <Setter Property="Foreground" Value="#2D1A00"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                    <Style x:Key="BtnTeal" BasedOn="{StaticResource Btn}" TargetType="Button">
                        <Setter Property="Background" Value="#19B88A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style x:Key="BtnGhost" BasedOn="{StaticResource Btn}" TargetType="Button">
                        <Setter Property="Background" Value="#C4B89A"/>
                        <Setter Property="Foreground" Value="#2D1A00"/>
                    </Style>
                    <Style x:Key="BtnDanger" BasedOn="{StaticResource Btn}" TargetType="Button">
                        <Setter Property="Background" Value="#D94F3D"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                    <Style x:Key="BtnIcon" BasedOn="{StaticResource Btn}" TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#6B3516"/>
                        <Setter Property="Padding"    Value="8,0"/>
                        <Setter Property="FontSize"   Value="15"/>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <tb:TaskbarIcon x:Key="TrayIcon"
                            IconSource="/Resources/icon.ico"
                            ToolTipText="Altéchap"
                            TrayMouseDoubleClick="Tray_DoubleClick"
                            TrayRightMouseUp="Tray_RightClick">
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
