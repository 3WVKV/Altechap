<Window x:Class="Altechap.Views.CharacterEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier le personnage" Height="440" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#D9D2C3" Foreground="#2D1A00">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#6B3516"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="0,6,0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"       Value="#EDE6D8"/>
            <Setter Property="Foreground"       Value="#2D1A00"/>
            <Setter Property="BorderBrush"      Value="#B8A888"/>
            <Setter Property="BorderThickness"  Value="1.5"/>
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="FontSize"         Value="12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#6B3516"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nom -->
        <Label Grid.Row="0" Content="Nom du personnage *"/>
        <TextBox Grid.Row="1" x:Name="TxtName" Margin="0,0,0,10"/>

        <!-- Aperçu classe -->
        <Border Grid.Row="2" Background="#EDE6D8" CornerRadius="10"
                BorderBrush="#B8A888" BorderThickness="1.5"
                Padding="10,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="PreviewBadge" Width="36" Height="36" CornerRadius="18"
                        Background="#C4B89A" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Grid>
                        <Image x:Name="PreviewImage" Width="26" Height="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                        <TextBlock x:Name="PreviewIcon" Text="?"
                                   FontSize="18" FontWeight="Bold" Foreground="#6B3516"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Visible"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PreviewName" Text="Aucune classe"
                               FontSize="13" FontWeight="SemiBold" Foreground="#2D1A00"/>
                    <TextBlock Text="Cliquez une classe ci-dessous"
                               FontSize="10" Foreground="#8C7355"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Label Grid.Row="3" Content="Choisir une classe"/>

        <!-- Grille de classes -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <WrapPanel x:Name="ClassGrid" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Options avancées -->
        <Expander Grid.Row="5" Header="Options de détection avancées"
                  Foreground="#8C7355" FontSize="10" Margin="0,0,0,10">
            <StackPanel Margin="0,6,0,0">
                <Label Content="Motif de détection (optionnel)"/>
                <TextBox x:Name="TxtPattern" Margin="0,0,0,6"/>
                <CheckBox x:Name="ChkRegex" Content="Expression régulière"/>
            </StackPanel>
        </Expander>

        <!-- Boutons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Click="Cancel_Click" Template="{StaticResource RB}"
                    Background="#C4B89A" Foreground="#2D1A00"
                    Padding="12,0" Height="32" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Enregistrer" Click="OK_Click" Template="{StaticResource RB}"
                    Background="#19B88A" Foreground="White"
                    FontWeight="SemiBold" Padding="12,0" Height="32" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
