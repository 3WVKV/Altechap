<Window x:Class="Altechap.Views.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raccourcis — Altéchap" Height="560" Width="600"
        MinHeight="420" MinWidth="520" SizeToContent="Manual"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#D9D2C3" Foreground="#2D1A00">

    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Navigation -->
            <TextBlock Grid.Row="0" Text="Navigation (fenetre suivante / precedente)"
                       Foreground="#6B3516" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="40"/>  <!-- 32px de bouton + 6px de marge -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" FontSize="11"
                           Foreground="#8C7355" Margin="0,0,0,10"
                           Text="Cliquez Capturer puis appuyez la touche souhaitee."/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Fenetre suivante"
                           VerticalAlignment="Center" Foreground="#6B3516" FontSize="12" FontWeight="SemiBold"/>
                <Border Grid.Row="2" Grid.Column="1" Background="#EDE6D8" CornerRadius="8"
                        BorderBrush="#B8A888" BorderThickness="1.5" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtNext" FontFamily="Consolas" FontSize="12" Foreground="#19B88A" FontWeight="SemiBold"/>
                </Border>
                <Button Grid.Row="2" Grid.Column="2" Content="Capturer" Click="CaptureNext_Click" Cursor="Hand"
                        Template="{StaticResource RB}" Background="#C4B89A" Foreground="#2D1A00"
                        Padding="10,0" Height="30" FontSize="11"/>
                <Button Grid.Row="2" Grid.Column="3" Content="&#x2715;" Click="ClearNext_Click" Cursor="Hand"
                        Template="{StaticResource RBClear}"
                        Width="32" Height="32" FontSize="13" Padding="0" Margin="6,0,0,0"
                        ToolTip="Effacer ce raccourci"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Fenetre precedente"
                           VerticalAlignment="Center" Foreground="#6B3516" FontSize="12" FontWeight="SemiBold"/>
                <Border Grid.Row="4" Grid.Column="1" Background="#EDE6D8" CornerRadius="8"
                        BorderBrush="#B8A888" BorderThickness="1.5" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtPrev" FontFamily="Consolas" FontSize="12" Foreground="#19B88A" FontWeight="SemiBold"/>
                </Border>
                <Button Grid.Row="4" Grid.Column="2" Content="Capturer" Click="CapturePrev_Click" Cursor="Hand"
                        Template="{StaticResource RB}" Background="#C4B89A" Foreground="#2D1A00"
                        Padding="10,0" Height="30" FontSize="11"/>
                <Button Grid.Row="4" Grid.Column="3" Content="&#x2715;" Click="ClearPrev_Click" Cursor="Hand"
                        Template="{StaticResource RBClear}"
                        Width="32" Height="32" FontSize="13" Padding="0" Margin="6,0,0,0"
                        ToolTip="Effacer ce raccourci"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Profil suivant"
                           VerticalAlignment="Center" Foreground="#6B3516" FontSize="12" FontWeight="SemiBold"/>
                <Border Grid.Row="6" Grid.Column="1" Background="#EDE6D8" CornerRadius="8"
                        BorderBrush="#B8A888" BorderThickness="1.5" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtNextProfile" FontFamily="Consolas" FontSize="12" Foreground="#19B88A" FontWeight="SemiBold"/>
                </Border>
                <Button Grid.Row="6" Grid.Column="2" Content="Capturer" Click="CaptureNextProfile_Click" Cursor="Hand"
                        Template="{StaticResource RB}" Background="#C4B89A" Foreground="#2D1A00"
                        Padding="10,0" Height="30" FontSize="11"/>
                <Button Grid.Row="6" Grid.Column="3" Content="&#x2715;" Click="ClearNextProfile_Click" Cursor="Hand"
                        Template="{StaticResource RBClear}"
                        Width="32" Height="32" FontSize="13" Padding="0" Margin="6,0,0,0"
                        ToolTip="Effacer ce raccourci"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Afficher / masquer"
                           VerticalAlignment="Center" Foreground="#6B3516" FontSize="12" FontWeight="SemiBold"
                           ToolTip="Rappeler ou masquer la fenêtre Altéchap. Actif même quand Altéchap a le focus."/>
                <Border Grid.Row="8" Grid.Column="1" Background="#EDE6D8" CornerRadius="8"
                        BorderBrush="#B8A888" BorderThickness="1.5" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtToggleWindow" FontFamily="Consolas" FontSize="12" Foreground="#19B88A" FontWeight="SemiBold"/>
                </Border>
                <Button Grid.Row="8" Grid.Column="2" Content="Capturer" Click="CaptureToggleWindow_Click" Cursor="Hand"
                        Template="{StaticResource RB}" Background="#C4B89A" Foreground="#2D1A00"
                        Padding="10,0" Height="30" FontSize="11"/>
                <Button Grid.Row="8" Grid.Column="3" Content="&#x2715;" Click="ClearToggleWindow_Click" Cursor="Hand"
                        Template="{StaticResource RBClear}"
                        Width="32" Height="32" FontSize="13" Padding="0" Margin="6,0,0,0"
                        ToolTip="Effacer ce raccourci"/>
            </Grid>

            <!-- Focus direct -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Focus direct par personnage"
                           Foreground="#6B3516" FontSize="13" FontWeight="Bold"/>
                <TextBlock Text="  (fenêtres actives uniquement)" VerticalAlignment="Bottom"
                           Foreground="#9C7A58" FontSize="11" Margin="0,0,0,1"/>
            </StackPanel>

            <!-- En-tete colonnes -->
            <Border Grid.Row="4" Background="#CFC8B8" CornerRadius="6,6,0,0"
                    BorderBrush="#B8A888" BorderThickness="1.5,1.5,1.5,0">
                <!-- Marge droite = largeur de la barre de défilement de la liste,
                     sinon l'en-tête et les lignes ne sont pas alignés -->
                <Grid Margin="0,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Personnage" Foreground="#6B3516"
                               FontWeight="SemiBold" FontSize="12" Padding="10,6"/>
                    <TextBlock Grid.Column="1" Text="Raccourci" Foreground="#6B3516"
                               FontWeight="SemiBold" FontSize="12" Padding="6,6"/>
                </Grid>
            </Border>

            <!-- Liste persos via ItemsControl -->
            <Border Grid.Row="5" Background="#EDE6D8" CornerRadius="0,0,6,6"
                    BorderBrush="#B8A888" BorderThickness="1.5,0,1.5,1.5">
                <Grid>
                <TextBlock x:Name="TxtNoDirect" Visibility="Collapsed"
                           Text="Aucune fenêtre Dofus ouverte — lancez vos clients pour leur affecter une touche.&#10;Les raccourcis déjà enregistrés sont conservés."
                           TextAlignment="Center" TextWrapping="Wrap" FontSize="11"
                           Foreground="#9C7A58" Margin="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <ItemsControl x:Name="LstDirect">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="4" BorderBrush="#D0C9B8" BorderThickness="0,0,0,1" Margin="6,0"/>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="10,0,4,0">
                                        <TextBlock Text="{Binding CharName}" FontSize="12"
                                                   Foreground="#2D1A00" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StateText}" FontSize="10" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Foreground="#9C7A58" FontStyle="Italic"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#D9D2C3" CornerRadius="6"
                                            BorderBrush="#B8A888" BorderThickness="1" Padding="6,3" Margin="4,5">
                                        <TextBlock Text="{Binding Hotkey}" FontFamily="Consolas" FontSize="11"
                                                   Foreground="#19B88A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Grid.Column="2" Content="Capturer" Tag="{Binding}"
                                            Click="CaptureDirect_Click" Cursor="Hand"
                                            Template="{StaticResource RB}" Background="#C4B89A" Foreground="#2D1A00"
                                            Padding="6,0" Height="30" FontSize="11" Margin="2,5,6,5" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Content="&#x2715;" Tag="{Binding}"
                                            Click="ClearDirect_Click" Cursor="Hand"
                                            Template="{StaticResource RBClear}"
                                            Width="32" Height="32" FontSize="13" Padding="0"
                                            ToolTip="Effacer ce raccourci"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </Border>

            <!-- Boutons bas -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Annuler" Click="Cancel_Click" Cursor="Hand"
                        Template="{StaticResource RB}" Background="#C4B89A" Foreground="#2D1A00"
                        Padding="14,0" Height="32" Margin="0,0,8,0"/>
                <Button Content="Enregistrer" Click="OK_Click" Cursor="Hand"
                        Template="{StaticResource RB}" Background="#19B88A" Foreground="White"
                        FontWeight="SemiBold" Padding="14,0" Height="32"/>
            </StackPanel>
        </Grid>

        <!-- Overlay capture -->
        <Border x:Name="CaptureOverlay" Background="#CCD9D2C3" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#EDE6D8" CornerRadius="16" BorderBrush="#B8A888" BorderThickness="2" Padding="40,32">
                    <StackPanel>
                        <TextBlock Text="&#x2328;" FontSize="48" HorizontalAlignment="Center" Foreground="#19B88A"/>
                        <TextBlock Text="Appuyez une touche..." FontSize="17" Foreground="#6B3516"
                                   HorizontalAlignment="Center" Margin="0,14,0,10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtCaptured" FontSize="22" FontWeight="Bold"
                                   Foreground="#19B88A" HorizontalAlignment="Center" FontFamily="Consolas"/>
                        <Button Content="Annuler" Margin="0,20,0,0" Click="CancelCapture_Click" Cursor="Hand"
                                Template="{StaticResource RB}" Background="#D94F3D" Foreground="White"
                                FontWeight="SemiBold" Padding="20,0" Height="36"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
