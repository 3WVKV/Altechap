<Window x:Class="Altechap.Views.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choisir une fenêtre Dofus" Height="310" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#D9D2C3" Foreground="#2D1A00">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="0,0,0,10"
                   Foreground="#6B3516" FontSize="12" FontWeight="SemiBold">
            Sélectionnez la fenêtre à lier :
        </TextBlock>
        <ListBox x:Name="Lst" Grid.Row="1"
                 Background="#EDE6D8" BorderBrush="#B8A888" BorderThickness="1.5"
                 Foreground="#2D1A00">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,8">
                        <StackPanel>
                            <TextBlock Text="{Binding CharName}"
                                       FontWeight="SemiBold" FontSize="13" Foreground="#2D1A00"/>
                            <TextBlock Text="{Binding RawTitle}" FontSize="10"
                                       Foreground="#8C7355" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ProcessExe}"
                                       FontSize="10" Foreground="#B8A888"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuler" Click="Cancel_Click" Template="{StaticResource RB}"
                    Background="#C4B89A" Foreground="#2D1A00"
                    Padding="12,0" Height="32" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Lier cette fenêtre" Click="OK_Click" Template="{StaticResource RB}"
                    Background="#19B88A" Foreground="White"
                    FontWeight="SemiBold" Padding="12,0" Height="32" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
